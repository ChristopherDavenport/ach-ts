{
  "name": "ach-ts",
  "version": "1.0.0",
  "description": "TypeScript port of moov-io/ach - ACH file generation and parsing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/dir.d.ts",
      "import": "./dist/dir.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE.md",
    "README.md",
    "NOTICE",
    "licenses/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ChristopherDavenport/ach-ts.git"
  },
  "homepage": "https://github.com/ChristopherDavenport/ach-ts",
  "bugs": {
    "url": "https://github.com/ChristopherDavenport/ach-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["ach", "nacha", "banking", "finance"],
  "author": "Christopher Davenport",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
